{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://todo-app.com/schemas/reminder-event.v1.json",
  "title": "Reminder Event Schema",
  "description": "Event schema for reminder notifications published to reminders topic",
  "type": "object",
  "required": ["event_id", "schema_version", "timestamp", "reminder_id", "task_id", "user_id", "title", "remind_at"],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for this event"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Event schema version (semver format)"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Event generation time in UTC (ISO 8601 format)"
    },
    "reminder_id": {
      "type": "string",
      "pattern": "^reminder-\\d+-[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "description": "Unique identifier for idempotency (format: reminder-{task_id}-{remind_at})"
    },
    "task_id": {
      "type": "integer",
      "minimum": 1,
      "description": "Task to remind about"
    },
    "user_id": {
      "type": "integer",
      "minimum": 1,
      "description": "User to notify"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Task title for notification body"
    },
    "remind_at": {
      "type": "string",
      "format": "date-time",
      "description": "When to send notification (ISO 8601 UTC)"
    },
    "due_date": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "Task due date for context (optional)"
    }
  }
}
