# Backend .dockerignore Contract
# Comprehensive exclusion patterns for FastAPI + Python 3.13 Docker builds
# Purpose: Reduce build context size from ~200MB to ~5MB (97% reduction)
# Research: specs/001-docker-containerization/research.md

# ==============================================================================
# Python Cache Files
# Will be regenerated during runtime
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.pyc
*.pyo
*.pyd

# ==============================================================================
# Virtual Environments
# Will be created in builder stage
# ==============================================================================
venv/
env/
ENV/
.venv/
.env/
env.bak/
venv.bak/
pythonenv*/

# ==============================================================================
# Environment Files
# Contains secrets, must NEVER be included in image
# ==============================================================================
.env
.env.*
.env.local
.env.development
.env.production
.env.staging
.env.test

# Include .env.example for documentation (optional)
!.env.example

# ==============================================================================
# Version Control
# Not needed in container
# ==============================================================================
.git/
.gitignore
.gitattributes
.gitmodules

# ==============================================================================
# IDE and Editor Files
# Development tools only
# ==============================================================================
.vscode/
.idea/
*.swp
*.swo
*.swn
*~
.project
.classpath
.settings/
.DS_Store
.AppleDouble
.LSOverride
*.iml

