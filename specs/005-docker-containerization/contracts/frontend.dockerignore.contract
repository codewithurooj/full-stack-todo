# Frontend .dockerignore Contract
# Comprehensive exclusion patterns for Next.js 15+ Docker builds
# Purpose: Reduce build context size from ~500MB to ~8MB (98% reduction)
# Research: specs/001-docker-containerization/research.md

# ==============================================================================
# Dependencies
# Will be installed via npm ci in Dockerfile
# ==============================================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# Lock file copied separately in Dockerfile
# Uncomment if NOT using npm ci (but npm ci is recommended)
# package-lock.json

# Yarn files (if not using yarn)
yarn.lock
.yarn/
.pnp.*

# ==============================================================================
# Build Output
# Will be generated during Docker build
# ==============================================================================
.next/
out/
dist/
build/
.turbo/

# ==============================================================================
# Environment Files
# Contains secrets, must NEVER be included in image
# ==============================================================================
.env
.env*.local
.env.local
.env.development
.env.production
.env.staging
.env.test

# Include .env.example for documentation (optional)
!.env.example

# ==============================================================================
# Version Control
# Not needed in container
# ==============================================================================
.git/
.gitignore
.gitattributes
.gitmodules

# ==============================================================================
# IDE and Editor Files
# Development tools only
# ==============================================================================
.vscode/
.idea/
*.swp
*.swo
*.swn
*~
.project
.classpath
.settings/
.DS_Store
.AppleDouble
.LSOverride

# ==============================================================================
# Testing and Coverage
# Tests not needed in production container
# ==============================================================================
coverage/
.nyc_output/
*.test.ts
*.test.tsx
*.test.js
*.test.jsx
*.spec.ts
*.spec.tsx
*.spec.js
*.spec.jsx
__tests__/
__mocks__/
jest.config.js
jest.config.ts
vitest.config.ts
cypress/
cypress.config.ts
playwright.config.ts
e2e/

# ==============================================================================
# Documentation
# Not needed in runtime
# ==============================================================================
README.md
CHANGELOG.md
LICENSE
LICENSE.txt
CONTRIBUTING.md
*.md
docs/
.github/

# ==============================================================================
# Docker Files
# Don't include Docker files in build context
# ==============================================================================
Dockerfile
Dockerfile.*
.dockerignore
docker-compose.yml
docker-compose.*.yml
.docker/

# ==============================================================================
# Development Configuration
# Dev-only files not needed in production
# ==============================================================================
.eslintrc.js
.eslintrc.json
.eslintrc.yml
.eslintignore
.prettierrc
.prettierrc.js
.prettierrc.json
.prettierignore
.editorconfig
.browserslistrc
.stylelintrc
.stylelintrc.json
tsconfig.tsbuildinfo

# Note: tsconfig.json and next.config.js ARE needed for build
# Do NOT exclude these files

# ==============================================================================
# Logs and Temporary Files
# ==============================================================================
logs/
*.log
pids/
*.pid
*.seed
*.pid.lock
lib-cov/
.grunt/
.lock-wscript/

# ==============================================================================
# Cache Directories
# Will be regenerated during build
# ==============================================================================
.cache/
.parcel-cache/
.npm/
.eslintcache
.stylelintcache
.node_repl_history

# ==============================================================================
# OS Files
# System-specific files
# ==============================================================================
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.Spotlight-V100/
.Trashes/
._*
.fseventsd/
.TemporaryItems/
.VolumeIcon.icns/

# ==============================================================================
# Miscellaneous
# ==============================================================================
*.tgz
*.gz
*.zip
*.tar
*.rar

# Storybook
.storybook/
storybook-static/

# Next.js specific
.vercel/
.now/

# TypeScript
*.tsbuildinfo

# Optional npm cache directory
.npm/

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# ==============================================================================
# Why Exclude Each Category
# ==============================================================================

# node_modules/ (~300MB):
# - Will be installed fresh via npm ci
# - Ensures consistent versions from package-lock.json
# - Reduces build context size significantly

# .next/ (~50MB):
# - Generated during Docker build
# - Prevents stale build artifacts
# - Ensures fresh build every time

# .env* (contains secrets):
# - Never include secrets in Docker image
# - Prevents accidental credential leakage
# - Environment-specific, not portable

# .git/ (~50-200MB):
# - Git history not needed in container
# - Prevents accidental credential leakage (git config)
# - Reduces build context size

# coverage/ (~10-50MB):
# - Test coverage reports not needed in production
# - Reduces image size
# - Faster builds

# Documentation (~1-5MB):
# - README, markdown files not needed in runtime
# - Keeps container focused on application

# ==============================================================================
# Build Context Impact
# ==============================================================================

# Without .dockerignore:
# - Build context: ~500MB
# - Transfer time: 10-30 seconds
# - Includes: node_modules, .git, coverage, .next, etc.

# With .dockerignore:
# - Build context: ~8MB
# - Transfer time: 1-2 seconds
# - Includes: Only source code and config files
# - Reduction: 98%

# Verify build context size:
#   docker build --progress=plain -t test:latest . 2>&1 | grep "Sending build context"

# ==============================================================================
# Negation Patterns (Advanced)
# ==============================================================================

# To exclude all .env files but include .env.example:
# .env*
# !.env.example

# To exclude all markdown but include specific files:
# *.md
# !README.md

# To exclude node_modules except specific package:
# node_modules/
# !node_modules/critical-package/

# ==============================================================================
# Pattern Syntax
# ==============================================================================

# *.log        - All .log files in current directory only
# **/*.log     - All .log files recursively (any depth)
# logs/        - Entire logs directory
# !important   - Include file/directory (negation)

# ==============================================================================
# Testing .dockerignore
# ==============================================================================

# Build with verbose output to see context size:
#   docker build --progress=plain -t frontend:test ./frontend 2>&1 | head -n 20

# Check what files are sent to Docker daemon:
#   docker build --no-cache -t frontend:test ./frontend 2>&1 | grep -i "sending"

# Expected output with proper .dockerignore:
#   Sending build context to Docker daemon: 8.5MB

# ==============================================================================
# Maintenance Notes
# ==============================================================================

# Review and update .dockerignore when:
# - Adding new build output directories
# - Changing project structure
# - Adding new development tools
# - Noticing slow build context transfers

# Regular audit:
#   docker build --progress=plain . 2>&1 | grep "Sending build context"
#   # Should be < 20MB for typical Next.js project
