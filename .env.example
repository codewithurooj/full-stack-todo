# ==============================================================================
# Environment Variables Template
# ==============================================================================
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env file to version control!

# ==============================================================================
# Database Configuration (Required)
# ==============================================================================
# Neon PostgreSQL connection string
# Format: postgresql://user:password@host.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# ==============================================================================
# Authentication (Required)
# ==============================================================================
# Shared secret for Better Auth JWT tokens
# Must be at least 32 characters long
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=your-secret-key-min-32-chars-change-this-value

# ==============================================================================
# API Configuration (Optional)
# ==============================================================================
# OpenAI API key for AI features (optional)
OPENAI_API_KEY=sk-your-openai-api-key

# OpenAI domain key for frontend (optional)
NEXT_PUBLIC_OPENAI_DOMAIN_KEY=your-openai-domain-key

# ==============================================================================
# Frontend Configuration
# ==============================================================================
# API URL for frontend to connect to backend
# Local development: http://localhost:8000
# Docker Compose: http://backend:8000 (handled automatically in docker-compose.yml)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ==============================================================================
# Docker-Specific Notes
# ==============================================================================
# When using Docker Compose:
#   - Place this .env file in the project root directory
#   - NEXT_PUBLIC_API_URL will be overridden to http://backend:8000 in docker-compose.yml
#   - All other variables will be injected into containers via env_file
#   - Both frontend and backend containers share the same .env file
#
# When running locally (without Docker):
#   - Frontend needs .env.local with NEXT_PUBLIC_API_URL=http://localhost:8000
#   - Backend needs .env with DATABASE_URL, BETTER_AUTH_SECRET, OPENAI_API_KEY
#
# Generate secrets:
#   openssl rand -hex 32  # For BETTER_AUTH_SECRET
