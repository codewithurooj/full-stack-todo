# Frontend .dockerignore
# Comprehensive exclusion patterns for Next.js 16+ Docker builds
# Purpose: Reduce build context size from ~500MB to ~8MB (98% reduction)

# ==============================================================================
# Dependencies
# Will be installed via npm ci in Dockerfile
# ==============================================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# Yarn files (if not using yarn)
yarn.lock
.yarn/
.pnp.*

# ==============================================================================
# Build Output
# Will be generated during Docker build
# ==============================================================================
.next/
out/
dist/
build/
.turbo/

# ==============================================================================
# Environment Files
# Contains secrets, must NEVER be included in image
# ==============================================================================
.env
.env*.local
.env.local
.env.development
.env.production
.env.staging
.env.test

# Include .env.example for documentation (optional)
!.env.example

# ==============================================================================
# Version Control
# Not needed in container
# ==============================================================================
.git/
.gitignore
.gitattributes
.gitmodules

# ==============================================================================
# IDE and Editor Files
# Development tools only
# ==============================================================================
.vscode/
.idea/
*.swp
*.swo
*.swn
*~
.project
.classpath
.settings/
.DS_Store
.AppleDouble
.LSOverride

# ==============================================================================
# Testing and Coverage
# Tests not needed in production container
# ==============================================================================
coverage/
.nyc_output/
*.test.ts
*.test.tsx
*.test.js
*.test.jsx
*.spec.ts
*.spec.tsx
*.spec.js
*.spec.jsx
__tests__/
__mocks__/
jest.config.js
jest.config.ts
vitest.config.ts
cypress/
cypress.config.ts
playwright.config.ts
e2e/

# ==============================================================================
# Documentation
# Not needed in runtime
# ==============================================================================
README.md
CHANGELOG.md
LICENSE
LICENSE.txt
CONTRIBUTING.md
*.md
docs/
.github/

# ==============================================================================
# Docker Files
# Don't include Docker files in build context
# ==============================================================================
Dockerfile
Dockerfile.*
.dockerignore
docker-compose.yml
docker-compose.*.yml
.docker/

# ==============================================================================
# Development Configuration
# Dev-only files not needed in production
# ==============================================================================
.eslintrc.js
.eslintrc.json
.eslintrc.yml
.eslintignore
.prettierrc
.prettierrc.js
.prettierrc.json
.prettierignore
.editorconfig
.browserslistrc
.stylelintrc
.stylelintrc.json
tsconfig.tsbuildinfo

# Note: tsconfig.json and next.config.js ARE needed for build

# ==============================================================================
# Logs and Temporary Files
# ==============================================================================
logs/
*.log
pids/
*.pid
*.seed
*.pid.lock
lib-cov/
.grunt/
.lock-wscript/

# ==============================================================================
# Cache Directories
# Will be regenerated during build
# ==============================================================================
.cache/
.parcel-cache/
.npm/
.eslintcache
.stylelintcache
.node_repl_history

# ==============================================================================
# OS Files
# System-specific files
# ==============================================================================
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.Spotlight-V100/
.Trashes/
._*
.fseventsd/
.TemporaryItems/
.VolumeIcon.icns/

# ==============================================================================
# Miscellaneous
# ==============================================================================
*.tgz
*.gz
*.zip
*.tar
*.rar

# Storybook
.storybook/
storybook-static/

# Next.js specific
.vercel/
.now/

# TypeScript
*.tsbuildinfo

# Optional npm cache directory
.npm/

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz
