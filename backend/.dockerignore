# Backend .dockerignore
# Comprehensive exclusion patterns for FastAPI + Python 3.13 Docker builds
# Purpose: Reduce build context size from ~200MB to ~5MB (97% reduction)

# ==============================================================================
# Python Cache Files
# Will be regenerated during runtime
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.pyc
*.pyo
*.pyd

# ==============================================================================
# Virtual Environments
# Will be created in builder stage
# ==============================================================================
venv/
env/
ENV/
.venv/
.env/
env.bak/
venv.bak/
pythonenv*/

# ==============================================================================
# Environment Files
# Contains secrets, must NEVER be included in image
# ==============================================================================
.env
.env.*
.env.local
.env.development
.env.production
.env.staging
.env.test

# Include .env.example for documentation (optional)
!.env.example

# ==============================================================================
# Version Control
# Not needed in container
# ==============================================================================
.git/
.gitignore
.gitattributes
.gitmodules

# ==============================================================================
# IDE and Editor Files
# Development tools only
# ==============================================================================
.vscode/
.idea/
*.swp
*.swo
*.swn
*~
.project
.classpath
.settings/
.DS_Store
.AppleDouble
.LSOverride
*.iml

# ==============================================================================
# Testing and Coverage
# Tests not needed in production container
# ==============================================================================
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/
.cache/
nosetests.xml
pytest.ini
setup.cfg
tox.ini

# Test files (various naming conventions)
test_*.py
*_test.py
*.test.py
tests/
test/

# ==============================================================================
# Documentation
# Not needed in runtime
# ==============================================================================
README.md
CHANGELOG.md
LICENSE
LICENSE.txt
CONTRIBUTING.md
AUTHORS
MANIFEST.in
*.md
*.rst
docs/
doc/
.github/
.gitlab/

# ==============================================================================
# Docker Files
# Don't include Docker files in build context
# ==============================================================================
Dockerfile
Dockerfile.*
.dockerignore
docker-compose.yml
docker-compose.*.yml
.docker/

# ==============================================================================
# Database Files
# Migrations and local database files
# ==============================================================================
*.db
*.sqlite
*.sqlite3
*.sqlite-journal
migrations/
alembic/
*.sql

# ==============================================================================
# Distribution and Packaging
# Build artifacts not needed
# ==============================================================================
dist/
build/
*.egg-info/
*.egg
*.whl
.eggs/
pip-log.txt
pip-delete-this-directory.txt

# ==============================================================================
# Jupyter Notebooks
# Development notebooks not needed
# ==============================================================================
.ipynb_checkpoints/
*.ipynb
profile_default/

# ==============================================================================
# Logs and Temporary Files
# ==============================================================================
logs/
*.log
*.log.*
.mypy_cache/
.dmypy.json
dmypy.json
*.pid
*.seed

# ==============================================================================
# Development Configuration
# Dev-only files not needed in production
# ==============================================================================
.flake8
.pylintrc
.pylint.d/
.pycodestyle
.pydocstyle
.pydocstylerc
.bandit
.editorconfig
.pre-commit-config.yaml
mypy.ini
setup.py
setup.cfg
pyproject.toml.bak

# Note: Keep requirements.txt for pip install

# ==============================================================================
# OS Files
# System-specific files
# ==============================================================================
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.Spotlight-V100/
.Trashes/
._*
.fseventsd/
.TemporaryItems/
.VolumeIcon.icns/

# ==============================================================================
# Security and Credentials
# ==============================================================================
*.key
*.pem
*.cer
*.crt
*.p12
*.pfx
credentials.json
service-account.json
secrets/
.secrets/

# ==============================================================================
# Miscellaneous
# ==============================================================================
*.tar.gz
*.tgz
*.gz
*.zip
*.rar
*.7z
*.bz2

# Celery
celerybeat-schedule
celerybeat.pid

# SageMath
*.sage.py

# Spyder
.spyderproject
.spyproject

# Rope
.ropeproject

# mkdocs
site/
