# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=reminders
CONSUMER_GROUP_ID=notification-service

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/todo_db

# Web Push VAPID Keys
# Generate with: python -c "from pywebpush import generate_vapid_keys; print(generate_vapid_keys())"
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_CLAIMS_EMAIL=mailto:admin@example.com

# Notification Settings
BATCH_WINDOW_SECONDS=120        # 2 minutes
RATE_LIMIT_PER_USER=10          # 10 notifications per user
RATE_LIMIT_WINDOW_SECONDS=60    # per minute

# Logging
LOG_LEVEL=INFO
