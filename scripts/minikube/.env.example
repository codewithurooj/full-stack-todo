# =============================================================================
# Minikube Cluster Configuration
# Feature: 006-minikube-setup
# =============================================================================
#
# This file contains all configurable environment variables for Minikube setup.
# Copy this file to .env and customize as needed:
#   cp .env.example .env
#
# Note: .env is gitignored to prevent accidental commits of local configuration

# -----------------------------------------------------------------------------
# CLUSTER IDENTITY
# -----------------------------------------------------------------------------

# Minikube profile name (allows multiple isolated clusters)
# Default: todo-dev
MINIKUBE_PROFILE=todo-dev

# -----------------------------------------------------------------------------
# RESOURCE ALLOCATION
# -----------------------------------------------------------------------------

# Number of CPUs allocated to the cluster
# Recommended: 4 (minimum: 2)
# Note: Host machine should have 2+ additional CPUs for OS
MINIKUBE_CPU=4

# Memory allocated to the cluster (in MB)
# Recommended: 8192 (8GB) (minimum: 2048 / 2GB)
# Note: Host machine should have 4GB+ additional RAM for OS
MINIKUBE_MEMORY=8192

# Disk size allocated to the cluster
# Recommended: 40g (minimum: 20g)
# Includes: Container images, persistent volumes, logs
MINIKUBE_DISK=40g

# -----------------------------------------------------------------------------
# DRIVER CONFIGURATION
# -----------------------------------------------------------------------------

# Container/VM driver for Minikube
# Options: docker, virtualbox, hyperv, kvm2, vmware
# Recommended: docker (cross-platform, fast startup, CI/CD friendly)
# Platform-specific defaults:
#   - Windows: docker or hyperv
#   - macOS: docker or hyperkit
#   - Linux: docker or kvm2
MINIKUBE_DRIVER=docker

# Container runtime inside Minikube
# Options: docker, containerd, cri-o
# Recommended: docker (default, widely compatible)
CONTAINER_RUNTIME=docker

# -----------------------------------------------------------------------------
# KUBERNETES VERSION
# -----------------------------------------------------------------------------

# Kubernetes version to install
# Options: stable, latest, v1.28.0, v1.29.0, etc.
# Recommended: stable (automatically uses latest stable Kubernetes version)
# Note: Check compatibility with kubectl version
K8S_VERSION=stable

# -----------------------------------------------------------------------------
# NETWORKING
# -----------------------------------------------------------------------------

# Network plugin for Kubernetes
# Options: auto, bridge, host
# Recommended: auto (minikube selects appropriate plugin)
NETWORK_PLUGIN=auto

# Enable DNS addon (required for service discovery)
# Options: true, false
# Recommended: true
ENABLE_DNS=true

# -----------------------------------------------------------------------------
# ADDONS
# -----------------------------------------------------------------------------

# Enable NGINX Ingress Controller addon
# Provides HTTP/HTTPS routing with domain-based traffic distribution
# Options: true, false
ENABLE_INGRESS=true

# Enable Metrics Server addon
# Provides resource monitoring (kubectl top, HPA support)
# Options: true, false
ENABLE_METRICS_SERVER=true

# Enable Kubernetes Dashboard addon
# Provides web UI for cluster management and visualization
# Options: true, false
ENABLE_DASHBOARD=true

# Enable default storage class addon
# Provides dynamic persistent volume provisioning
# Options: true, false
ENABLE_STORAGE=true

# -----------------------------------------------------------------------------
# PERFORMANCE TUNING
# -----------------------------------------------------------------------------

# Wait timeout for cluster startup (in seconds)
# Default: 300 (5 minutes)
# Increase if cluster takes longer to start on slow machines
CLUSTER_START_TIMEOUT=300

# Wait timeout for addon enablement (in seconds)
# Default: 120 (2 minutes)
# Increase if addons take longer to become ready
ADDON_ENABLE_TIMEOUT=120

# Metrics collection delay (in seconds)
# Default: 60 (1 minute)
# Time to wait after enabling metrics-server before checking metrics
METRICS_COLLECTION_DELAY=60

# -----------------------------------------------------------------------------
# ADVANCED CONFIGURATION
# -----------------------------------------------------------------------------

# Extra flags to pass to minikube start
# Example: --extra-config=kubelet.max-pods=110
# Default: empty
EXTRA_MINIKUBE_FLAGS=

# Extra flags to pass to kubectl
# Example: --request-timeout=30s
# Default: empty
EXTRA_KUBECTL_FLAGS=

# Automatically delete existing cluster on startup
# Options: true, false
# Warning: Setting to true will delete existing cluster without prompting
AUTO_DELETE_EXISTING=false

# Verbose output for debugging
# Options: true, false
# When true, shows detailed command output
VERBOSE=false

# -----------------------------------------------------------------------------
# REGISTRY MIRRORS (Optional - for faster image pulls)
# -----------------------------------------------------------------------------

# Docker registry mirror (comma-separated list)
# Example: https://mirror.gcr.io,https://dockerhub.azk8s.cn
# Default: empty (use default Docker Hub)
REGISTRY_MIRROR=

# Insecure registries (comma-separated list)
# Example: localhost:5000,registry.example.com
# Default: empty
INSECURE_REGISTRY=

# -----------------------------------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------------------------------

# Enable experimental features
# Options: true, false
# Warning: May be unstable
ENABLE_EXPERIMENTAL=false

# Enable IPv6
# Options: true, false
# Note: Requires host IPv6 support
ENABLE_IPV6=false

# Enable GPU support
# Options: true, false
# Note: Requires compatible hardware and drivers
ENABLE_GPU=false

# -----------------------------------------------------------------------------
# MAINTENANCE
# -----------------------------------------------------------------------------

# Auto-cleanup old images on startup
# Options: true, false
# Recommended: false (manual cleanup safer)
AUTO_CLEANUP_IMAGES=false

# Keep failed cluster for debugging
# Options: true, false
# When true, does not delete cluster if startup fails
KEEP_FAILED_CLUSTER=false

# Log level for scripts
# Options: debug, info, warn, error
# Default: info
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# END OF CONFIGURATION
# -----------------------------------------------------------------------------
